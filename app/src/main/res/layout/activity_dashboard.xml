<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary"
    tools:context=".DashboardActivity">

    <!-- Header gradient similar to MainActivity -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnMenuMain"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_null"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="@color/text_on_dark" />

            <TextView
                android:id="@+id/txtDashboardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Xin chào"
                android:textColor="@color/text_on_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnDashboardAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_null"
                android:src="@drawable/ic_user"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDashboardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hãy trải nghiệm ngay nào!"
            android:textColor="@color/text_on_dark"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shortcut cards row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnDashboardPractice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card_primary"
            android:text="Luyện tập"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnDashboardMockExam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card_primary"
            android:text="Thi thử"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Shortcut cards row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnDashboardSmart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card_primary"
            android:text="Ôn thông minh (AI)"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnDashboardLeaderboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card_primary"
            android:text="Bảng xếp hạng"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Shortcut cards row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnDashboardBookmarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_card_primary"
            android:text="Câu hỏi đã đánh dấu"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnDashboardHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card_primary"
            android:text="Lịch sử làm bài"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Placeholder card section; will be populated with real stats later -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtDashboardStatsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thống kê sẽ hiển thị ở đây."
                android:textSize="15sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>


